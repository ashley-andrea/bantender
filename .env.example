# Copy to .env on the server. Never commit .env.
ENVIRONMENT=prod
DOMAIN=pricing.example.com

STORAGE=local

# AI is off unless explicitly enabled (the assistant needs AI_PROVIDER=openai and a key).
# Budget cap applies to the whole deployment.
AI_PROVIDER=off
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BUDGET_USD=5

CORS_ORIGINS=["https://pricing.example.com"]
